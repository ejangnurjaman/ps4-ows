<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp"
        tools:context="com.truecarbide.ps4ows.MainActivity">

        <!-- B. Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:contentDescription="App Logo"
            android:src="@drawable/logo" />

        <!-- C. Nama Aplikasi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="PS4 OWS"
            android:textColor="#CCCCCC"
            android:textSize="28dp" />

        <!-- D. Informasi Server (Border + Teks Biru) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_border_blue"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Info Icon"
                    android:src="@drawable/ic_info"
                    app:tint="#64B5F6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Server Information"
                    android:textColor="#64B5F6"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Port: 8080"
                android:textColor="#90CAF9"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network: "
                    android:textColor="#90CAF9"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvNetworkStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:textColor="#90CAF9"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvServerUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="URL: http://0.0.0.0:8080"
                android:textColor="#90CAF9"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- C (2). Form Select Toolkit ZIP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Select Toolkit (ps4ows.zip):"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llZipPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_select_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvZipPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="No ZIP selected"
                    android:textColor="#2196F3"
                    android:textColorHint="#2196F3"
                    android:textSize="14sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- D (2). Tombol Start/Stop Server -->
        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="Start Server"
            android:textSize="16sp"
            android:background="@drawable/bg_start_btn"
            android:textColor="@color/white"/>

        <!-- E. Kotak Peringatan (Border + Teks Kuning) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_border_yellow"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Warning Icon"
                    android:src="@drawable/ic_warning"
                    app:tint="#FFE082" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Warning"
                    android:textColor="#FFE082"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="It is recommended to turn off Wi-Fi and mobile data before starting the process."
                android:textColor="#FFE082"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- F. Tombol Navigasi / Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHowToUse"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How to use"
                android:textColor="#64B5F6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#555555" />

            <Button
                android:id="@+id/btnAbout"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About"
                android:textColor="#64B5F6" />
        </LinearLayout>

        <!-- Spacer pendorong footer ke bawah jika screen tinggi -->

        <!-- G. Footer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PS4 OWS is created by youtube.com/@truecarbide"
                android:textColor="#777777"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Powered by weebsu.com"
                android:textColor="#777777"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Spacer pendorong agar tidak tertutup nav bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</ScrollView>
